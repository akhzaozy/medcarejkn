# Server Configuration
NODE_ENV=development
PORT=5174

# PostgreSQL Database Configuration
# Use 'postgres' when running inside Docker, or 'localhost' when running natively
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jkn_integrity
DB_USER=jkn_user
DB_PASSWORD=jkn_password

# CORS & Client Configuration
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api


# Bcrypt hashes supplied through private deployment environment (never commit actual values)
JKN_STAFF_PASSWORD_HASH=
JKN_CLINICIAN_PASSWORD_HASH=
# For a private bcrypt value containing $, preserve the value with single quotes.
# The same quoting is required in this Portainer stack's environment fields.
# Never commit an actual account hash to this example file.
